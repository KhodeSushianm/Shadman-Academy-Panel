# ── وابستگی‌ها ────────────────────────────────────────────────
# بدون اسلش انتهایی، تا هم پوشه و هم فایل هم‌نام را بگیرد
node_modules
jspm_packages
bower_components

# ── فایل‌های دیتابیس کاربر ────────────────────────────────────
# این‌ها داده‌ی واقعی دانش‌آموزان‌اند و هرگز نباید وارد ریپو شوند
*.sqlite
*.sqlite.bak
*.sqlite.tmp
*.sqlite-journal
*.db

# ── خروجی بسته‌بندی ───────────────────────────────────────────
dist/
out/
release/
# پوشه‌ی build فقط منابع بیلد (آیکون) را نگه می‌دارد، نه خروجی‌ها
build/*
!build/icon.ico
!build/icon.png
*.dmg
*.AppImage
*.exe
*.deb

# ── سیستم‌عامل و ویرایشگر ─────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.log
npm-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/extensions.json

# ── محیط ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
